# Maak een kopie met de naam .env en vul je eigen Amadeus API-gegevens in.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Gebruik test.api.amadeus.com tijdens ontwikkeling.
AMADEUS_BASE_URL=https://test.api.amadeus.com
PORT=4180

# Optionele Google Flights scraping/API providers voor de volgende stap.
# Vul er later maximaal één in om echte Google Flights-achtige data op te halen.
SERPAPI_API_KEY=
SEARCHAPI_API_KEY=
BRIGHT_DATA_API_KEY=
